{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run user service",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/apps/user-service/cmd",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run message service",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/apps/message-service/cmd",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run content service",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/apps/content-service/cmd",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run social service",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/apps/social-service/cmd",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Run all services",
      "configurations": ["Run user service", "Run message service", "Run content service", "Run social service"],
      "stopAll": true
    }
  ]
}
